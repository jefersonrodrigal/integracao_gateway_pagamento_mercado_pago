# Copie para .env e preencha. NUNCA versione o arquivo .env.

# --- Aplicação ---
APP_ENV=development            # development | test | staging | production
APP_NAME=payment-api
LOG_LEVEL=INFO
LOG_JSON=true
DOCS_ENABLED=true              # false em produção

# --- Banco de dados (driver assíncrono obrigatório) ---
# No docker compose esta variável é sobrescrita para apontar ao serviço "db".
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/payments

# --- Mercado Pago ---
# Access Token SOMENTE no backend. A Orders API não aceita credenciais de teste:
# em homologação use as credenciais de PRODUÇÃO de uma conta/usuário de TESTE.
MERCADO_PAGO_ACCESS_TOKEN=
# Assinatura secreta gerada em "Suas integrações > Webhooks > Configurar notificações".
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_BASE_URL=https://api.mercadopago.com
MERCADO_PAGO_TIMEOUT_SECONDS=15
MERCADO_PAGO_MAX_RETRIES=2
# Texto na fatura do cartão (até 22 caracteres), opcional.
MERCADO_PAGO_STATEMENT_DESCRIPTOR=
PIX_EXPIRATION=PT1H            # ISO 8601: mínimo 30 min, máximo 30 dias
BOLETO_EXPIRATION=P3D          # ISO 8601: 1 a 30 dias (recomendado >= 3)

# --- Webhooks ---
WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=600
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_PROCESS_INLINE=true    # processa logo após o 200; o worker garante a entrega

# --- Autenticação (JWT do provedor de identidade) ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ISSUER=payment-api
JWT_AUDIENCE=payment-api

# --- Segurança HTTP ---
CORS_ALLOWED_ORIGINS=          # ex.: https://loja.exemplo.com.br (separados por vírgula)
FORCE_HTTPS=false              # true em produção (obrigatório)
TRUST_PROXY_HEADERS=false      # true somente atrás de proxy confiável
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_WEBHOOK_PER_MINUTE=600

# --- Regras comerciais ---
SHIPPING_FLAT_FEE=0.00
FREE_SHIPPING_THRESHOLD=
MAX_ORDER_AMOUNT=100000.00
MAX_INSTALLMENTS=12

# --- Reconciliação e retenção ---
IDEMPOTENCY_TTL_HOURS=24
RECONCILE_INTERVAL_SECONDS=600
UNKNOWN_PAYMENT_GIVE_UP_SECONDS=3600
PAYMENT_EVENT_RETENTION_DAYS=365
WORKER_POLL_INTERVAL_SECONDS=5
